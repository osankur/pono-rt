@TIME_DOMAIN continuous
MODULE main
VAR
  loc :  boolean;
  err1 : boolean;
  err2 : boolean;
  x : clock;
  y : clock;
ASSIGN
  init(err1) := FALSE;
  init(err2) := FALSE;
  init(x) := 0.0;
  init(y) := 0.0;
  next(x) := case
    loc & x >= 2.0 : 0.0;
    TRUE : x;
  esac;
  next(y) := case
    !loc & y >= 2.0 : 0.0;
    TRUE : y;
  esac;
  init(loc) := TRUE;
  next(loc) := case
    loc  & x >= 2.3 : !loc;
    !loc & y >= 2.0 : !loc;
    TRUE : loc;
  esac;
  next(err1) := case
    loc & x > y & time < 2.0: TRUE;
    TRUE : FALSE;
  esac;
  next(err2) := case
    loc & x > y & time < 3.0: TRUE;
    TRUE : FALSE;
  esac;
INVARSPEC !err1
INVARSPEC !err2
