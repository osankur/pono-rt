@TIME_DOMAIN continuous
MODULE main
VAR
  loc:  unsigned word[3];
  x : clock;
  y : clock;
  t : clock;
ASSIGN
  init(x) := 0.0;
  init(y) := 0.0;
  init(t) := 0.0;
  next(x) := case
    loc = 0ud3_0 : 0.0;
    loc = 0ud3_1 : x;
    TRUE : x;
  esac;
  next(t) := t;
  next(y) := case
    loc = 0ud3_0 : y;
    loc = 0ud3_1 : 0.0;
    TRUE : y;
  esac;
  init(loc) := 0ud3_0;
  next(loc) := case
    loc = 0ud3_0 : 0ud3_1;
    loc = 0ud3_1 : 0ud3_2;
    loc = 0ud3_2 & t - x < x - y : 0ud3_3;
    loc = 0ud3_2 & t - x > x - y: 0ud3_4;
    TRUE : loc;
  esac;
URGENT
  loc = 0ud3_0
INVARSPEC loc != 0ud3_3; -- false
INVARSPEC loc != 0ud3_4; -- true, thanks to the urgency constraint
